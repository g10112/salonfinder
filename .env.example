# Obtain a key from https://myprojects.geoapify.com/
# Leave unset for explicitly labelled fictional demo data.
GEOAPIFY_API_KEY=
# Bind to 127.0.0.1 for local development. Docker uses HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000
# Optionally set the expected public site origin for stricter API CORS protection.
PUBLIC_ORIGIN=